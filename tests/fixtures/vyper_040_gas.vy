@payable
def f3(x: uint256) -> uint256:
    return x + 3

@external
def f4(x: uint256) -> uint256:
    return x + 4

@external
@payable
def f5(x: uint256) -> uint256:
    return x + 5

@external
def f6(x: uint256) -> uint256:
    return x + 6

@external
@payable
def f7(x: uint256) -> uint256:
    return x + 7

@external
def f8(x: uint256) -> uint256:
    return x + 8

@external
@payable
def f9(x: uint256) -> uint256:
    return x + 9

@external
def f10(x: uint256) -> uint256:
