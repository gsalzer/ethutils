@external
@payable
def __default__():
    pass

@external
def f0(x: uint256) -> uint256:
    return x + 0

@external
@payable
def f1(x: uint256) -> uint256:
    return x + 1

@external
def f2(x: uint256) -> uint256:
    return x + 2

